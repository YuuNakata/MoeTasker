{
    "version": 2,
    "builds": [
      {
        "src": "api/telegram.py", 
        "use": "@vercel/python"
      },
      {
        "src": "api/cron/*.py", 
        "use": "@vercel/python"
      }
    ],
    "rewrites": [
    { "source": "/(.*)", "destination": "/api/telegram.py" }
      ],
    "crons": [
      {
        "path": "/api/cron/daily_reminder",
        "schedule": "0 13 * * *" 
      }
    ]
  }