{
    "version": 2,
    "builds": [
      {
        "src": "api/telegram.py", 
        "use": "@vercel/python"
      },
      {
        "src": "api/cron/*.py", 
        "use": "@vercel/python"
      }
    ],
    "routes": [
      
      { "src": "/api/telegram", "dest": "/api/telegram.py" },
      { "src": "/api/cron/daily_reminder", "dest": "/api/cron/daily_reminder.py" },
      { "src": "/api/cron/random_message", "dest": "/api/cron/random_message.py" }
    ],
    "crons": [
      {
        "path": "/api/cron/daily_reminder",
        "schedule": "0 13 * * *" 
      }
    ]
  }